# Copia este archivo como .env y completa solo los valores necesarios.
INMOBIL_SMTP_HOST=smtp.gmail.com
INMOBIL_SMTP_PORT=587
INMOBIL_SMTP_SSL=false
INMOBIL_EMAIL_SENDER=
INMOBIL_EMAIL_PASSWORD=

# true abre Chrome sin interfaz durante el scraping.
INMOBIL_HEADLESS=false
INMOBIL_KNOWN_ID_REPEAT_LIMIT=5

# Fuente futura: Search API oficial de Idealista.
INMOBIL_IDEALISTA_API_KEY=
INMOBIL_IDEALISTA_API_SECRET=
